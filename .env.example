# Required
TELEGRAM_BOT_TOKEN=123456:replace-me

# Optional
PILOT_WORKDIR=/workspace
PILOT_DATA_DIR=/workspace/data
LOG_LEVEL=INFO

# Optional Gmail IMAP access skill config
# GMAIL_EMAIL=your.address@gmail.com
# GMAIL_APP_PASSWORD=your-gmail-app-password
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993

# Optional Brave Search skill config
# BRAVE_SEARCH_API_KEY=your-brave-api-key

# Optional Home Assistant skill config
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=your-long-lived-access-token

# Optional GitHub personal access token (used by pi for PR creation, API calls, etc.)
# GITHUB_PAT=ghp_...

# Extra pi CLI args. Secrets/provider/model config should usually be env vars consumed by pi.
# PI_ARGS=--model anthropic/claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
