# Required
TELEGRAM_BOT_TOKEN=123456:replace-me

# Optional
PILOT_WORKDIR=/workspace
LOG_LEVEL=INFO
PILOT_BEHAVIOR_PROMPT=You are pi.lot, a helpful AI coding assistant connected through Telegram.
# PILOT_BEHAVIOR_PROMPT_PATH=/app/behavior.md

# Extra pi CLI args. Secrets/provider/model config should usually be env vars consumed by pi.
# PI_ARGS=--model anthropic/claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
